{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "LedgerEvent",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "txHash",
  "logIndex",
  "vault",
  "block",
  "ts",
  "kind",
  "data"
 ],
 "properties": {
  "txHash": {
   "type": "string",
   "pattern": "^0x[0-9a-f]{64}$"
  },
  "logIndex": {
   "type": "integer",
   "minimum": 0
  },
  "vault": {
   "type": "string",
   "pattern": "^0x[0-9a-fA-F]{40}$"
  },
  "block": {
   "type": "integer"
  },
  "ts": {
   "type": "integer",
   "description": "unix seconds"
  },
  "kind": {
   "enum": [
    "Settled",
    "Invested",
    "BillPaid",
    "Borrowed",
    "Repaid",
    "Protected",
    "PolicyChanged",
    "PayeeSet",
    "OperatorSet",
    "Paused",
    "Closed",
    "BillRefused"
   ]
  },
  "data": {
   "type": "object",
   "description": "decoded event args; all uint values as decimal strings"
  }
 }
}