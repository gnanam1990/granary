{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "BillRequest",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "payee",
  "amount",
  "memo"
 ],
 "properties": {
  "payee": {
   "type": "string",
   "pattern": "^0x[0-9a-fA-F]{40}$"
  },
  "amount": {
   "type": "string",
   "pattern": "^[1-9][0-9]{0,12}$",
   "description": "USDC micro-units"
  },
  "memo": {
   "type": "string",
   "maxLength": 31
  }
 }
}