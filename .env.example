# Granary — environment template. Copy to .env (never commit .env).

# --- chain ---
BASE_RPC_URL=https://mainnet.base.org          # replace with a keyed RPC for production
BASE_RPC_FALLBACK_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
CHAIN_ID=8453

# --- addresses (Base mainnet; verified 2026-11-24, re-check in M01) ---
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
MORPHO_ADDRESS=0xBBBBBbbBBb9cC5e90e3b3Af64bdAF62C37EEFFCb
SWAP_ROUTER_ADDRESS=                          # set after spike S6
GRANARY_FACTORY_ADDRESS=                      # set after M09 deploy
GRANARY_FACTORY_DEPLOY_BLOCK=

# --- keys ([HUMAN] creates and funds; gas money only) ---
DEPLOYER_PRIVATE_KEY=
OPERATOR_PRIVATE_KEY=
BASESCAN_API_KEY=

# --- builder code ([HUMAN] registers; see sponsor digest section 8) ---
BUILDER_CODE=                                 # bc_xxxxxxxx

# --- keeper ---
KEEPER_PORT=8787
KEEPER_DB_PATH=./data/granary.sqlite
KEEPER_CYCLE_SECONDS=15
MIN_SETTLE_MICRO=10000                        # 0.01 USDC
MIN_INVEST_MICRO=1000000                      # 1 USDC
REORG_RESCAN_BLOCKS=20
TEAM_WALLETS=                                 # comma-separated; excluded from /v1/stats
BILLS_HMAC_MASTER_SECRET=                     # derive one key per vault from this
SWAP_QUOTE_API_URL=                           # set after spike S6
TOKENIZED_STOCKS_API=https://api.coinbase.com/v1/tokenized-stocks
MORPHO_GRAPHQL_URL=https://blue-api.morpho.org/graphql

# --- x402 (seller side; dogfood API) ---
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
X402_PAY_TO=                                  # the dogfood vault address
X402_ENVIRONMENT=development                  # development | production

# --- web ---
NEXT_PUBLIC_CHAIN_ID=8453
NEXT_PUBLIC_KEEPER_URL=http://localhost:8787
NEXT_PUBLIC_FACTORY_ADDRESS=
NEXT_PUBLIC_BUILDER_CODE=
BLOCKED_COUNTRIES=US                          # ISO codes, comma-separated. Consider adding GB.

# --- LLM (M08 only) ---
ANTHROPIC_API_KEY=
POLICY_ASSISTANT_MODEL=claude-haiku-5-5
